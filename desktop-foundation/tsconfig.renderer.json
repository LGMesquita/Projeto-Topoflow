{
  "extends": "./tsconfig.json",

  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",

    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],

    "types": []
  },

  "include": [
    "src/renderer/**/*.ts",
    "src/shared/**/*.ts",
    "src/types/**/*.d.ts",
    "src/declarations.d.ts"
  ]
}